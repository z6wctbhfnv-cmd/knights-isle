# Copy to .env (never commit .env). Without the chain variables the server runs with CHAIN=sim.
BOT_TOKEN=
BOT_USERNAME=
# Public domain of the server (Caddy gets HTTPS for it) and the Mini App address
DOMAIN=
WEBAPP_URL=
ADMIN_KEY=
DEV_AUTH=0
DEMO_CONTROLS=1

# Database: a local file, or Turso
DATABASE_URL=file:data/isle.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# NEAR testnet
CHAIN=testnet
GAME_ACCOUNT=knights-isle.testnet
GAME_ACCOUNT_KEY=
CHAIN_KEY_SECRET=
NEAR_RPC=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
POOL_PER_EPOCH_YOCTO=10000000000000000000000
# Testnet mode runs only on the database marked as this game account's world.
# Set to 1 once to start a brand-new world (use a new GAME_ACCOUNT for that).
CHAIN_NEW_WORLD=

# Bot: webhook when WEBAPP_URL is https, long polling otherwise (or force with BOT_MODE=polling)
BOT_MODE=
# Mini App build: the bot username for invite links
VITE_BOT_USERNAME=
