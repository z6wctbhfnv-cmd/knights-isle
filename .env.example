# Copy to .env (never commit .env). Without the chain variables the server runs with CHAIN=sim.
BOT_TOKEN=
BOT_USERNAME=
WEBAPP_URL=
ADMIN_KEY=
DEV_AUTH=0
DEMO_CONTROLS=1

# Database: a local file, or Turso
DATABASE_URL=file:data/isle.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# NEAR testnet
CHAIN=testnet
GAME_ACCOUNT=knights-isle.testnet
GAME_ACCOUNT_KEY=
CHAIN_KEY_SECRET=
NEAR_RPC=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
POOL_PER_EPOCH_YOCTO=10000000000000000000000
